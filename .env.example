# ─── Backend (server/) ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Database (Prisma — not yet active in Phase 0)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/integrix_ai

# Google Gemini API key — BACKEND ONLY, never expose to frontend
# GEMINI_API_KEY=your_gemini_api_key_here

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (client/) ──────────────────────────────────────────────────────
# VITE_* variables are embedded in the browser bundle and are PUBLIC.
# Do NOT place production API keys in VITE_* variables.
VITE_API_URL=http://localhost:5000/api


